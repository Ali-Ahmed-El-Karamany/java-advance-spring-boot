<?xml version="1.0" encoding="UTF-8" ?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="1793650735579-1" author="Ali ElKaramany">
        <createTable tableName="addresses">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="addresses_pk"/>
            </column>

            <column name="country" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="governance" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="city" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="street" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="building_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="floor_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="apartment_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="addresses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>