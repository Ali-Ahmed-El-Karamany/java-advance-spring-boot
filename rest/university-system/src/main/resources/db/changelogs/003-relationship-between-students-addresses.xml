<?xml version="1.0" encoding="UTF-8" ?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="1793702009320-1" author="Ali ElKaramany">
        <addColumn tableName="students">
            <column name="address_id" type="UUID"/>
        </addColumn>

        <addForeignKeyConstraint baseTableName="students"
                                 baseColumnNames="address_id"
                                 constraintName="fk_students_addresses"
                                 referencedTableName="addresses"
                                 referencedColumnNames="id"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="students" constraintName="fk_students_addresses"/>
            <dropColumn tableName="students" columnName="address_id"/>
        </rollback>
    </changeSet>


</databaseChangeLog>